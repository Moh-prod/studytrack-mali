rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Fonctions utilitaires ─────────────────────────────────────────────────

    // Vérifie que l'utilisateur est authentifié
    function isAuthenticated() {
      return request.auth != null;
    }

    // Vérifie que l'utilisateur est le propriétaire du document
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Vérifie que le uid dans les données de création correspond à l'utilisateur
    function isCreatingAsOwner() {
      return isAuthenticated() && request.resource.data.uid == request.auth.uid;
    }

    // ── Tâches ───────────────────────────────────────────────────────────────
    match /tasks/{taskId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isCreatingAsOwner();
      allow update: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // ── Habitudes ────────────────────────────────────────────────────────────
    match /habits/{habitId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isCreatingAsOwner();
      allow update: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // ── Notes ────────────────────────────────────────────────────────────────
    match /notes/{noteId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isCreatingAsOwner();
      allow update: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // ── Journal ──────────────────────────────────────────────────────────────
    match /journal_entries/{entryId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isCreatingAsOwner();
      allow update: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // ── Dépenses ─────────────────────────────────────────────────────────────
    match /expenses/{expenseId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isCreatingAsOwner();
      allow update: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // ── Newsletter ───────────────────────────────────────────────────────────
    // Écriture ouverte pour permettre l'inscription, lecture réservée aux admins
    match /newsletter_subscribers/{docId} {
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['email', 'subscribedAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() < 320;
      allow read, update, delete: if false; // Géré via Cloud Functions ou console Firebase
    }

    // ── Bloquer tout autre accès ──────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
